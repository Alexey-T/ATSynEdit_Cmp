<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="6">
    <Name Value="atsynedit_cmp_package"/>
    <Type Value="RunTimeOnly"/>
    <Author Value="Alexey Torgashin"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)-$(LCLWidgetType)-$(FPCVer)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <IncludeAssertionCode Value="True"/>
        </SyntaxOptions>
      </Parsing>
      <CodeGeneration>
        <Checks>
          <RangeChecks Value="True"/>
          <OverflowChecks Value="True"/>
        </Checks>
      </CodeGeneration>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf2Set"/>
        </Debugging>
      </Linking>
    </CompilerOptions>
    <Description Value="Auto-completion for ATSynEdit. General form with listbox, and helpers for: HTML completion, CSS completion, file:/// paths completion, CudaText .acp files completion."/>
    <License Value="MPL 2.0, LGPL"/>
    <Version Major="2" Minor="3" Release="1"/>
    <Files>
      <Item>
        <Filename Value="atsynedit_cmp_filenames.pas"/>
        <UnitName Value="ATSynEdit_Cmp_Filenames"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_cmp_acpfiles.pas"/>
        <UnitName Value="ATSynEdit_Cmp_AcpFiles"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_cmp_css.pas"/>
        <UnitName Value="ATSynEdit_Cmp_CSS"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_cmp_html.pas"/>
        <UnitName Value="ATSynEdit_Cmp_HTML"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_cmp_form.pas"/>
        <UnitName Value="ATSynEdit_Cmp_Form"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_cmp_fileuri.pas"/>
        <UnitName Value="ATSynEdit_Cmp_FileURI"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_cmp_css_provider.pas"/>
        <UnitName Value="ATSynEdit_Cmp_CSS_Provider"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_cmp_html_provider.pas"/>
        <UnitName Value="ATSynEdit_Cmp_HTML_Provider"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_cmp_renderhtml.pas"/>
        <UnitName Value="ATSynEdit_Cmp_RenderHTML"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="atsynedit_package"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
